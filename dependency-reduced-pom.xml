<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>local</groupId>
  <artifactId>cie-cns-wedge</artifactId>
  <version>1.0</version>
  <build>
    <finalName>cie-cns-wedge</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>core-lib</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>core</classifier>
              <excludes>
                <exclude>com/dadaops/cardreader/PcscCardSource*.class</exclude>
                <exclude>com/dadaops/cardreader/PcscCardLink*.class</exclude>
                <exclude>com/dadaops/cardreader/DesktopImageDecoder*.class</exclude>
                <exclude>com/dadaops/cardreader/ApiServer*.class</exclude>
                <exclude>com/dadaops/cardreader/TrayUi*.class</exclude>
                <exclude>com/dadaops/cardreader/IdentityServer*.class</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer>
                  <mainClass>com.dadaops.cardreader.IdentityServer</mainClass>
                </transformer>
                <transformer />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <jmrtd.version>0.7.42</jmrtd.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <bc.version>1.78.1</bc.version>
    <scuba.version>0.0.20</scuba.version>
  </properties>
</project>

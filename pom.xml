<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>local</groupId>
    <artifactId>cie-cns-wedge</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- VERIFICA: controlla su Maven Central le ultime versioni disponibili. -->
        <jmrtd.version>0.7.42</jmrtd.version>
        <!-- IMPOSTA questa alla versione di scuba-sc-j2se presente su Central:
             https://repo1.maven.org/maven2/net/sf/scuba/scuba-sc-j2se/
             idealmente uguale alla versione di scuba-smartcards vista in
             'mvn dependency:tree | findstr scuba'. -->
        <scuba.version>0.0.20</scuba.version>
        <bc.version>1.78.1</bc.version>
    </properties>

    <dependencies>
        <!-- Source: https://mvnrepository.com/artifact/io.github.jnasmartcardio/jnasmartcardio -->

        <dependency>
            <groupId>org.jmrtd</groupId>
            <artifactId>jmrtd</artifactId>
            <version>${jmrtd.version}</version>
        </dependency>
        <!-- Contiene TerminalCardService (adattatore javax.smartcardio -> SCUBA).
             NON arriva transitivamente da jMRTD (che porta solo il core scuba-smartcards),
             quindi va dichiarato esplicitamente. -->
        <dependency>
            <groupId>net.sf.scuba</groupId>
            <artifactId>scuba-sc-j2se</artifactId>
            <version>${scuba.version}</version>
        </dependency>
        <!-- Crittografia richiesta da jMRTD per PACE -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bc.version}</version>
        </dependency>
        <!-- Decoder JPEG 2000 per ImageIO: la foto del volto (DG2) di CIE e passaporto
             e' tipicamente in image/jp2, non leggibile da Chrome/Firefox. Con questo
             plugin (registrato via ServiceLoader) la convertiamo in PNG lato server. -->
        <dependency>
            <groupId>com.github.jai-imageio</groupId>
            <artifactId>jai-imageio-jpeg2000</artifactId>
            <version>1.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>cie-cns-wedge</finalName>
        <plugins>
            <!-- Jar "core" (classifier: core) per l'inclusione in Android: SOLO le classi neutre,
                 ESCLUSE quelle desktop (PC/SC, AWT/tray, httpserver, ImageIO). L'app Android aggiunge
                 jmrtd + scuba-smartcards + bouncycastle e fornisce un CardSource su NFC IsoDep. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>core-lib</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>core</classifier>
                            <excludes>
                                <exclude>com/dadaops/cardreader/PcscCardSource*.class</exclude>
                                <exclude>com/dadaops/cardreader/PcscCardLink*.class</exclude>
                                <exclude>com/dadaops/cardreader/DesktopImageDecoder*.class</exclude>
                                <exclude>com/dadaops/cardreader/ApiServer*.class</exclude>
                                <exclude>com/dadaops/cardreader/TrayUi*.class</exclude>
                                <exclude>com/dadaops/cardreader/IdentityServer*.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Crea un fat-jar eseguibile con tutte le dipendenze incluse -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- BouncyCastle e' un jar firmato: dopo lo shade le firme non combaciano
                                 piu' e ImageIO (ServiceLoader sul classpath) lancerebbe SecurityException.
                                 Si rimuovono i file di firma dal fat-jar. -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.dadaops.cardreader.IdentityServer</mainClass>
                                </transformer>
                                <!-- Mantiene la registrazione SPI di ImageIO (plugin JPEG 2000) nel fat-jar -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>